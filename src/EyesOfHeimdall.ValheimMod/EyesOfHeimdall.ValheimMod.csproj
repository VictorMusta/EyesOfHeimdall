<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472: matches the Mono runtime BepInEx 5.x ships for Valheim. -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EyesOfHeimdall.ValheimMod</RootNamespace>
    <AssemblyName>EyesOfHeimdall.ValheimMod</AssemblyName>

    <!-- Override with `-p:ValheimDir=...` if the game lives somewhere else. -->
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ValheimManagedDir>$(ValheimDir)\valheim_Data\Managed</ValheimManagedDir>
    <BepInExCoreDir>$(ValheimDir)\BepInEx\core</BepInExCoreDir>

    <!-- Drop the built plugin straight into the game so `dotnet build` = ready to test. -->
    <PluginDeployDir>$(ValheimDir)\BepInEx\plugins\EyesOfHeimdall</PluginDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EyesOfHeimdall.Core\EyesOfHeimdall.Core.csproj" />
  </ItemGroup>

  <ItemGroup Label="BepInEx / Harmony">
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Label="Unity">
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Label="Valheim">
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy the built plugin (and its own dependencies, e.g. EyesOfHeimdall.Core.dll) into the
       game's plugins folder so it's playtest-ready after every build. Game/BepInEx assemblies are
       marked Private=false above so they never end up in this output to begin with. -->
  <Target Name="DeployPlugin" AfterTargets="Build">
    <ItemGroup>
      <DeployFiles Include="$(OutputPath)*.dll" />
      <DeployFiles Include="$(OutputPath)*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(PluginDeployDir)" Condition="!Exists('$(PluginDeployDir)')" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
